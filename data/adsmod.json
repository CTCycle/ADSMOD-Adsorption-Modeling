{
  "version": "3.0.0",
  "runtime": {
    "host": "127.0.0.1",
    "backend_port": 6045,
    "frontend_port": 5173
  },
  "storage": {
    "root": "%LOCALAPPDATA%/ADSMOD"
  },
  "application": {
    "database": {
      "embedded_database": true,
      "sqlite_path": "data/database.db"
    },
    "datasets": {
      "allowed_extensions": [
        ".csv",
        ".xls",
        ".xlsx"
      ],
      "column_detection_cutoff": 0.6
    },
    "nist": {
      "parallel_tasks": 40
    },
    "public_data": {
      "request_timeout_seconds": 20.0,
      "retry_attempts": 3,
      "retry_backoff_max_seconds": 30.0,
      "pubchem_parallel_requests": 2,
      "cod_max_interactive_results": 250,
      "health_cache_ttl_seconds": 900,
      "sync_batch_size": 50,
      "sync_max_records_per_run": 200,
      "sync_max_concurrent_jobs": 1,
      "sync_response_size_limit_bytes": 67108864,
      "sync_resume_on_startup": false,
      "auto_sync_enabled": false,
      "auto_sync_categories": [],
      "auto_sync_interval_hours": 24,
      "auto_sync_fraction": 1.0
    },
    "fitting": {
      "default_max_iterations": 1000,
      "max_iterations_upper_bound": 1000000000,
      "default_parameter_initial": 1.0,
      "default_parameter_min": 0.0,
      "default_parameter_max": 100.0,
      "preview_row_limit": 20,
      "best_model_metric": "AICc"
    },
    "jobs": {
      "polling_interval": 1.0
    },
    "training": {
      "persistent_workers": false
    }
  }
}
