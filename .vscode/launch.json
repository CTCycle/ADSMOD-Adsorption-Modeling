{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPYCACHEPREFIX": "${workspaceFolder}/runtimes/cache/python",
        "TEMP": "${workspaceFolder}/runtimes/cache/temp",
        "TMP": "${workspaceFolder}/runtimes/cache/temp",
        "TMPDIR": "${workspaceFolder}/runtimes/cache/temp",
        "PLAYWRIGHT_BROWSERS_PATH": "${workspaceFolder}/runtimes/cache/playwright"
      },
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/app/server/.venv/Scripts/python.exe"
    },
    {
      "name": "Debug: Backend",
      "type": "debugpy",
      "request": "launch",
      "module": "server.cli",
      "args": [
        "--config",
        "${workspaceFolder}/app/resources/adsmod.json"
      ],
      "jinja": true,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Uvicorn running on (http://\\S+)",
        "uriFormat": "%s/docs"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPYCACHEPREFIX": "${workspaceFolder}/runtimes/cache/python",
        "TEMP": "${workspaceFolder}/runtimes/cache/temp",
        "TMP": "${workspaceFolder}/runtimes/cache/temp",
        "TMPDIR": "${workspaceFolder}/runtimes/cache/temp",
        "PLAYWRIGHT_BROWSERS_PATH": "${workspaceFolder}/runtimes/cache/playwright"
      },
      "python": "${workspaceFolder}/app/server/.venv/Scripts/python.exe"
    },
    {
      "name": "Debug: Frontend",
      "type": "pwa-node",
      "request": "launch",
      "cwd": "${workspaceFolder}/app/client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "env": {
        "NPM_CONFIG_CACHE": "${workspaceFolder}/runtimes/cache/npm",
        "XDG_CACHE_HOME": "${workspaceFolder}/runtimes/cache",
        "TEMP": "${workspaceFolder}/runtimes/cache/temp",
        "TMP": "${workspaceFolder}/runtimes/cache/temp",
        "TMPDIR": "${workspaceFolder}/runtimes/cache/temp",
        "PLAYWRIGHT_BROWSERS_PATH": "${workspaceFolder}/runtimes/cache/playwright"
      },
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Local:\\s+(http://\\S+)",
        "uriFormat": "%s"
      },
      "autoAttachChildProcesses": false,
      "internalConsoleOptions": "neverOpen",
      "presentation": {
        "hidden": true
      }
    }
  ],
  "compounds": [
    {
      "name": "Debug: Frontend + Backend",
      "configurations": [
        "Debug: Backend",
        "Debug: Frontend"
      ],
      "stopAll": true
    }
  ]
}

