{
  "version": "3.0.0",
  "runtime": {
    "mode": "core",
    "host": "127.0.0.1",
    "core_port": 6045,
    "ml_port": 6046,
    "frontend_port": 5173,
    "ml_restart_attempts": 0
  },
  "storage": {
    "root": "%LOCALAPPDATA%/ADSMOD"
  },
  "security": {
    "internal_token_required": true,
    "internal_token_env": "ADSMOD_INTERNAL_TOKEN"
  },
  "application": {
    "database": {
      "embedded_database": true,
      "sqlite_path": "data/database.db"
    },
    "datasets": {
      "allowed_extensions": [".csv", ".xls", ".xlsx"],
      "column_detection_cutoff": 0.6
    },
    "nist": {
      "parallel_tasks": 40,
      "pubchem_parallel_tasks": 1
    },
    "fitting": {
      "default_max_iterations": 1000,
      "max_iterations_upper_bound": 1000000000,
      "default_parameter_initial": 1.0,
      "default_parameter_min": 0.0,
      "default_parameter_max": 100.0,
      "preview_row_limit": 20,
      "best_model_metric": "AICc"
    },
    "jobs": {
      "polling_interval": 1.0
    },
    "training": {
      "persistent_workers": false
    }
  }
}
