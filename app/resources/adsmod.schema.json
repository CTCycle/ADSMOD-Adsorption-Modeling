{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADSMOD v3 configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runtime", "storage", "security", "application"],
  "properties": {
    "version": { "const": "3.0.0" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "host", "core_port", "ml_port", "frontend_port", "ml_restart_attempts"],
      "properties": {
        "mode": { "enum": ["core", "core-ml"] },
        "host": { "enum": ["127.0.0.1", "localhost", "::1"] },
        "core_port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "ml_port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "frontend_port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "ml_restart_attempts": { "type": "integer", "minimum": 0, "maximum": 1 }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "database"],
      "properties": { "root": { "type": "string" }, "database": { "type": "string" } }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["internal_token_required"],
      "properties": { "internal_token_required": { "type": "boolean" } }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database", "datasets", "nist", "fitting", "jobs", "training"],
      "properties": {
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["embedded_database", "sqlite_path"],
          "properties": {
            "embedded_database": { "type": "boolean" },
            "sqlite_path": { "type": "string" }
          }
        },
        "datasets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed_extensions", "column_detection_cutoff"],
          "properties": {
            "allowed_extensions": { "type": "array", "items": { "type": "string" } },
            "column_detection_cutoff": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "nist": {
          "type": "object",
          "additionalProperties": false,
          "required": ["parallel_tasks", "pubchem_parallel_tasks"],
          "properties": {
            "parallel_tasks": { "type": "integer", "minimum": 1 },
            "pubchem_parallel_tasks": { "type": "integer", "minimum": 1 }
          }
        },
        "fitting": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default_max_iterations", "max_iterations_upper_bound", "default_parameter_initial", "default_parameter_min", "default_parameter_max", "preview_row_limit", "best_model_metric"],
          "properties": {
            "default_max_iterations": { "type": "integer", "minimum": 1 },
            "max_iterations_upper_bound": { "type": "integer", "minimum": 1 },
            "default_parameter_initial": { "type": "number", "minimum": 0 },
            "default_parameter_min": { "type": "number", "minimum": 0 },
            "default_parameter_max": { "type": "number", "minimum": 0 },
            "preview_row_limit": { "type": "integer", "minimum": 1 },
            "best_model_metric": { "type": "string" }
          }
        },
        "jobs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["polling_interval"],
          "properties": { "polling_interval": { "type": "number", "minimum": 0 } }
        },
        "training": {
          "type": "object",
          "additionalProperties": false,
          "required": ["persistent_workers"],
          "properties": { "persistent_workers": { "type": "boolean" } }
        }
      }
    }
  }
}
