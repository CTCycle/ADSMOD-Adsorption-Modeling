# Optional location for the ADSMOD application data directory.
# Database connection settings are stored in database.json inside that directory.
ADSMOD_STORAGE_ROOT=%LOCALAPPDATA%/ADSMOD

# Process runtime endpoints. The browser continues to call /api/v1; the local
# frontend proxy targets the backend endpoint formed from ADSMOD_HOST and
# ADSMOD_BACKEND_PORT.
ADSMOD_HOST=127.0.0.1
ADSMOD_BACKEND_PORT=6045
ADSMOD_FRONTEND_PORT=5173

# Optional comma-separated CORS overrides. If omitted, origins are derived from
# ADSMOD_HOST and ADSMOD_FRONTEND_PORT; credentials and wildcard methods/headers
# retain the existing local runtime policy.
# ADSMOD_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# ADSMOD_CORS_ALLOW_CREDENTIALS=true
# ADSMOD_CORS_ALLOW_METHODS=*
# ADSMOD_CORS_ALLOW_HEADERS=*
