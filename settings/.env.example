# ADSMOD database bootstrap values. Copy to settings/.env only when database
# selection, credentials, or data locations differ from the built-in defaults.
# User-editable application behavior settings live in the local SQLite database.

# The local SQLite database always stores application_settings. When this is
# true, it also stores operational application data.
ADSMOD_STORAGE_ROOT=%LOCALAPPDATA%/ADSMOD
DATABASE_SQLITE_PATH=data/database.db
EMBEDDED_DATABASE=true

# PostgreSQL is used only for operational application data when
# EMBEDDED_DATABASE=false. Application settings remain in DATABASE_SQLITE_PATH.
DATABASE_ENGINE=postgres
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_SSL_CA=
DATABASE_CONNECT_TIMEOUT=30
