# ============================================================
# ADSMOD developer environment
# ============================================================
# Copy this file to settings/.env for local tooling when needed.
# The Windows launcher uses app/resources/adsmod.json as the canonical runtime
# configuration; this file does not override its host, port, storage, database,
# or public-data settings.

# ============================================================
# Backend and launcher behavior
# ============================================================
# Set to false to keep backend logs hidden. Defaults to true when absent.
BACKEND_LOGS_VISIBLE=true

# Rebuild the frontend whenever the application starts. Defaults to true when absent.
RELOAD=false

# ============================================================
# Machine-learning and plotting defaults
# ============================================================
MPLBACKEND=Agg
KERAS_BACKEND=torch

# ============================================================
# Frontend development
# ============================================================
VITE_API_BASE_URL=/api

# ============================================================
# Resource location
# ============================================================
# Resource directory for the canonical configuration, logs, templates,
# checkpoints, and embedded SQLite database.
# Relative paths are resolved from the repository root.
ADSMOD_RESOURCES_DIR=app/resources
