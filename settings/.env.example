# Set to false to keep backend logs hidden. Defaults to true when absent.
BACKEND_LOGS_VISIBLE=true

RELOAD=false
MPLBACKEND="Agg"
KERAS_BACKEND=torch
VITE_API_BASE_URL=/api

# Resource directory for the canonical configuration, logs, templates, checkpoints, and embedded SQLite database.
# Relative paths are resolved from the repository root.
ADSMOD_RESOURCES_DIR=app/resources
