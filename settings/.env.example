# ============================================================
# ADSMOD developer environment
# ============================================================
# Copy this file to settings/.env for local tooling when needed.
# The Windows launcher uses data/adsmod.json as the default runtime
# configuration. Set ADSMOD_DATA_DIR below, or pass -DataPath to the
# launcher, to select a different directory containing adsmod.json.

# Rebuild the frontend whenever the application starts. Defaults to true when absent.
RELOAD=false

# ============================================================
# Machine-learning and plotting defaults
# ============================================================
MPLBACKEND=Agg
KERAS_BACKEND=torch

# ============================================================
# Data location
# ============================================================
# Directory for the canonical configuration and generated schema.
# Relative paths are resolved from the repository root.
ADSMOD_DATA_DIR=data
